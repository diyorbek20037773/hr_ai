    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "hr_ai_llm_queue_depth",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
