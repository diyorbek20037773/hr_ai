# hr_ai configuration template. Copy to .env (gitignored) and adjust.
# Never put real credentials in this file.

APP_HOST=127.0.0.1
APP_PORT=8001
LOG_LEVEL=INFO
LOG_DIR=logs

# Model — leave MODEL_PATH empty to auto-detect ./model or ./model/Qwen3-4B-Instruct-2507
MODEL_PATH=
# auto | cuda | cpu   (auto: CUDA when available, else CPU)
MODEL_DEVICE=auto
# auto | bfloat16 | float16 | float32
MODEL_DTYPE=auto
MODEL_MIN_FULL_GPU_VRAM_GB=9
# auto | none | 4bit | 8bit  (bitsandbytes; auto -> 4bit on CUDA when free VRAM < MODEL_MIN_FULL_GPU_VRAM_GB)
MODEL_QUANTIZATION=auto
# GPU memory budget for GPU+CPU offload (only used when MODEL_QUANTIZATION=none and VRAM is short)
MODEL_GPU_MAX_MEMORY_GB=
MODEL_MAX_NEW_TOKENS=512
MODEL_REPETITION_PENALTY=1.05
LLM_TIMEOUT_SECONDS=60
# requests waiting for / holding the model; more -> 503 LLM_BUSY
LLM_MAX_QUEUE=8

# Search model defaults
DEFAULT_SEARCH_ROWS=20
ACADEMIC_TITLE_ID_DEFAULT=0

# Fuzzy matching (RapidFuzz)
FUZZY_AUTO_MATCH_THRESHOLD=88
FUZZY_CANDIDATE_THRESHOLD=75
FUZZY_AMBIGUITY_MARGIN=3

# Existing HR Search API (empty URL => /search returns executed:false)
HR_SEARCH_API_URL=
HR_SEARCH_API_PATH=/api/search
HR_SEARCH_API_KEY=
HR_SEARCH_API_TIMEOUT=30

# Reference data API (empty => request payload + local JSON only)
REFERENCE_API_BASE_URL=
REFERENCE_CACHE_TTL_SECONDS=3600
LOCAL_REFERENCES_PATH=references/example_references.json
# local JSON holds placeholder IDs; /search refuses to send them to the HR API unless true
ALLOW_LOCAL_REFERENCES_FOR_SEARCH=false

# Security
AI_SEARCH_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
MAX_QUERY_LENGTH=1000
MAX_REFERENCE_ITEMS=20000
MAX_BODY_BYTES=5242880
# token_sort_ratio | ratio | WRatio | token_set_ratio
FUZZY_SCORER=token_sort_ratio
FUZZY_MAX_CANDIDATES=3
REFERENCE_API_TIMEOUT=10
# JSON object collection -> path, e.g. {"regions":"/dict/regions"}
REFERENCE_API_PATHS={}
